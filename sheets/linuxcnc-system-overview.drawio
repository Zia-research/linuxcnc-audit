        <mxCell id="tnml" parent="b6" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;" value="&lt;b&gt;NML &amp;#183; the only triplet&lt;/b&gt;&lt;br&gt;SHMEM &amp;#8212; shared memory,&lt;br&gt;like the two below&lt;br&gt;but this one never crosses&lt;br&gt;the boundary" vertex="1">
          <mxGeometry height="73.84615384615385" width="219.14285714285714" x="419.7142857142857" y="31.384615384615387" as="geometry" />
        </mxCell>
        <mxCell id="b7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=2;fontSize=13;strokeWidth=1;" value="&lt;b&gt;linuxcncsvr — master of the three channels&lt;/b&gt;&lt;br&gt;creates the segments · starts first&lt;br&gt;NML servers, TCP 5005 — its clients are remote" vertex="1">
          <mxGeometry height="75" width="300" x="1370" y="220" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee;strokeColor=#36393d;verticalAlign=top;spacingTop=2;fontSize=13;strokeWidth=1;dashed=1;" value="&lt;b&gt;remote NML client&lt;br&gt;&lt;/b&gt;&lt;br&gt;another computer; nothing realtime runs there&lt;br&gt;needs libnml — in practice another Linux with LinuxCNC&lt;br&gt;a GUI-only control PC; task, motion and HAL stay here&lt;br&gt;AXIS there needs AXIS_NO_HAL=1 — HAL is local memory —&lt;br&gt;and loses jog pins, pyvcp panels, classicladder&lt;br&gt;config: client.nml on it · server.nml on the machine&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;&lt;b&gt;no authentication on TCP 5005 — anything that reaches it writes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;client.nml / server.nml are NOT INSTALLED — source tree only&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;and declare emcStatus at 10240 B against 20480 — NML halves it again&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;unverified — run tool_watch to settle it&lt;/font&gt;" vertex="1">
          <mxGeometry height="238" width="380" x="1410" y="-510" as="geometry" />
        </mxCell>
        <mxCell id="b5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=2;fontSize=13;strokeWidth=1;dashed=1;" value="&lt;b&gt;halcmd / halshow&lt;/b&gt;&lt;br&gt;HAL clients &amp;#8212; hal_init() attaches HAL memory&lt;br&gt;a hand tool, not part of the cycle&lt;br&gt;setp writes a pin, getp reads one &amp;#8212; live&lt;br&gt;they never touch NML" vertex="1">
          <mxGeometry height="108" width="340" x="-220" y="4.5" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=2;fontSize=13;strokeWidth=1;dashed=1;" value="halui&lt;br&gt;no display at all — knobs and switches&lt;br&gt;[HAL]HALUI — adds, never replaces&lt;br&gt;47 HAL_IN + 42 HAL_OUT" vertex="1">
          <mxGeometry height="104" width="248" x="300" y="190.5" as="geometry" />
        </mxCell>
        <mxCell id="b0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=2;fontSize=13;strokeWidth=1;" value="&lt;b&gt;LOCAL GUI&lt;/b&gt;&lt;br&gt;axis &amp;#183; gmoccapy &amp;#183; touchy &amp;#183; gscreen &amp;#183; qtvcp screens (qtdragon&amp;#8230;)&lt;br&gt;each screen exports its OWN pins &amp;#8212; and the count differs&lt;br&gt;axisui 16 &amp;#183; qtdragon 18" vertex="1">
          <mxGeometry height="109" width="462" x="580" y="3.5" as="geometry" />
        </mxCell>
        <mxCell id="b8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=2;fontSize=13;strokeWidth=1;" value="milltask — the task process&lt;br&gt;tool, coolant, estop — no NML channel left for I/O" vertex="1">
          <mxGeometry height="168" width="952" x="439" y="484" as="geometry" />
        </mxCell>
        <mxCell id="b9" parent="b8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=2;fontSize=13;strokeWidth=1;" value="&lt;b&gt;RS-274 interpreter&lt;/b&gt;&lt;br&gt;librs274.so &amp;#8212; one class, TWO instances&lt;br&gt;task&amp;#39;s: canon &amp;#8594; interp_list &amp;#8594; motion" vertex="1">
          <mxGeometry height="90" width="224" x="28" y="42" as="geometry" />
        </mxCell>
        <mxCell id="b12" parent="b8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=2;fontSize=13;strokeWidth=1;" value="iocontrol.0.*&lt;br&gt;14 HAL pins&lt;br&gt;former io process" vertex="1">
          <mxGeometry height="90" width="196" x="721" y="42" as="geometry" />
        </mxCell>
        <mxCell id="b11" parent="b8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=2;fontSize=13;strokeWidth=1;" value="&lt;b&gt;sequencing&lt;/b&gt;&lt;br&gt;the task state machine &amp;#8212;&lt;br&gt;decides what runs next" vertex="1">
          <mxGeometry height="90" width="210" x="490" y="42" as="geometry" />
        </mxCell>
        <mxCell id="b10" parent="b8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=2;fontSize=13;strokeWidth=1;" value="interp_list&lt;br&gt;std::deque&lt;br&gt;throttled at 1000&lt;br&gt;[TASK]INTERP_MAX_LEN" vertex="1">
          <mxGeometry height="90" width="196" x="273" y="42" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee;strokeColor=#36393d;verticalAlign=top;spacingTop=2;fontSize=13;strokeWidth=1;dashed=1;" value="&lt;div&gt;&lt;b&gt;REMOTE GUI&lt;/b&gt;&lt;/div&gt;&lt;b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;telnet · nc · any socket client — plain text, not NML&lt;/b&gt;&lt;br&gt;a human or a program, on another machine&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;two passwords, but sent in the clear — man warns twice&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="320" x="1006" y="-394" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontColor=light-dark(#ff0000, #ededed);fontStyle=1" value="ordinary scheduling&lt;div&gt;&lt;span&gt;NOT REALTIME&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="16" width="103" x="-193" y="634" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontColor=light-dark(#ff0000, #ededed);fontStyle=1" value="&lt;span&gt;REALTIME&lt;/span&gt;&lt;div&gt;SCHED_FIFO · rtapi_app&lt;span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="16" width="60" x="-192" y="914" as="geometry" />
        </mxCell>
        <mxCell id="tstream" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#000000;" value="streamer / sampler &amp;#8212; the same kind of memory, optional&lt;div&gt;RTAPI segments of their own, created in realtime and&lt;/div&gt;&lt;div&gt;attached by halstreamer / halsampler, ordinary processes&lt;/div&gt;&lt;div&gt;&amp;#8212; so they cross this band too&lt;/div&gt;&lt;div&gt;keys 0x48535430+n (into HAL) &amp;#183; 0x48534130+n (out of HAL), 8 each&lt;/div&gt;&lt;div&gt;loaded, they are addf&#39;d into a thread and run in the cycle&lt;/div&gt;&lt;div&gt;shipped configs: streamer 0 of 332 &amp;#183; sampler 1 (the panelui demo)&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="370" x="1620" y="700" as="geometry" />
        </mxCell>
        <mxCell id="t5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontColor=#000000;" value="a scheduling boundary, not a kernel boundary&lt;br&gt;kernel modules only on the RTAI-&lt;i&gt;kernel&lt;/i&gt; flavour — 1 of the 5 RTAPI flavours;&lt;div&gt;uspace/RTAI is user space too&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="420" x="-330" y="730" as="geometry" />
        </mxCell>
