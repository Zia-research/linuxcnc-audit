        <mxCell id="legt8" parent="leg" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;detached=1;" value="&lt;b&gt;no fill&lt;/b&gt; &amp;#8212; a container, or a subdivision of its parent" vertex="1">
          <mxGeometry height="34" width="540" x="144" y="394" as="geometry" />
        </mxCell>
        <mxCell id="legrules" parent="leg" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;detached=1;" value="&lt;b&gt;Why it is coloured this way:&lt;/b&gt; so the colour can be checked, not admired.&lt;br&gt;&amp;#8226; every GREEN box must sit inside rtapi_app&lt;br&gt;&amp;#8226; every GREY box must sit above the remote line&lt;br&gt;&amp;#8226; the ORANGE box must sit below the machine line&lt;br&gt;&amp;#8226; every WHITE box must carry at least one link&lt;br&gt;All four hold as drawn. &lt;b&gt;And one trap&lt;/b&gt;: &amp;quot;process&amp;quot; and &amp;quot;non-realtime&amp;quot; are not the&lt;br&gt;same thing &amp;#8212; rtapi_app is a process and it lives below the line.&lt;br&gt;The letters on the NML strip say what each side DOES: the file declares task RW on&lt;br&gt;emcCommand, a permission it never uses." vertex="1">
          <mxGeometry height="160" width="664" x="20" y="446" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
